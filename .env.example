# AvrixCall — copy to .env.local (never commit .env.local)

# Shared Avrixlab Supabase project (ref vdutlzgqucpzfpwkotfg).
# Find these in the Supabase dashboard: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# Server only — never expose to the browser. Used by the admin API routes.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# Single shared password for the /admin login (test-grade auth).
ADMIN_PASSWORD=<choose-a-strong-password>

# LiveKit Cloud (free tier) — member-only video.
# Create a project at https://cloud.livekit.io, then copy the API key,
# secret and the project's WebSocket URL from the project settings.
# The secret is server-only: it signs every video token, never expose it.
LIVEKIT_API_KEY=<livekit api key>
LIVEKIT_API_SECRET=<livekit api secret>
NEXT_PUBLIC_LIVEKIT_URL=wss://<your-project>-<id>.livekit.cloud
