# AvrixCall — copy to .env.local (never commit .env.local)

# Shared Avrixlab Supabase project (ref vdutlzgqucpzfpwkotfg).
# Find these in the Supabase dashboard: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# Server only — never expose to the browser. Used by the admin API routes.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# Single shared password for the /admin login (test-grade auth).
ADMIN_PASSWORD=<choose-a-strong-password>

# Jitsi server. Default is the free public server. When moving to a
# self-hosted Jitsi server later, change ONLY this value.
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si
