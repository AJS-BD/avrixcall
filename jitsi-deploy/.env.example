# AvrixCall branded Jitsi — copy to .env and set CALLS_DOMAIN (3 places).
# Everything else is a plain, open Jitsi install: no auth, no rules.

# Public address of the calls server, e.g. https://call.avrixlab.com
PUBLIC_URL=https://CALLS_DOMAIN

# Server timezone (matches Avrixlab test environment)
TZ=Asia/Dhaka

# Web ports
HTTP_PORT=80
HTTPS_PORT=443

# Free TLS certificate for the domain
ENABLE_LETSENCRYPT=1
LETSENCRYPT_DOMAIN=CALLS_DOMAIN
LETSENCRYPT_EMAIL=its.xafor@gmail.com

# Video media port (UDP)
JVB_PORT=10000

# No login, no rules: anyone with a room link can join.
ENABLE_AUTH=0
ENABLE_GUESTS=1

# Off for v1 (can be switched on later)
ENABLE_RECORDING=0
ENABLE_TRANSCRIPTIONS=0
